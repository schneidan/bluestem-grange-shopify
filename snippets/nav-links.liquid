{%- liquid
  assign menu = section.settings.menu
-%}
<nav class="site-nav" aria-label="Primary">
  {%- if menu != blank -%}
    {%- for link in menu.links -%}
      <a
        href="{{ link.url }}"
        {% if link.current %}
          aria-current="page"
        {% endif %}
      >
        {{ link.title }}
      </a>
    {%- endfor -%}
  {%- else -%}
    <a
      href="{{ routes.root_url }}"
      {% if request.page_type == 'index' %}aria-current="page"{% endif %}
    >Shop</a>
    <a
      href="{{ routes.collections_url }}"
      {% if request.page_type == 'list-collections' %}aria-current="page"{% endif %}
    >Collections</a>
    <a href="{{ pages.about.url | default: '/pages/about' }}" {% if page.handle == 'about' %}aria-current="page"{% endif %}>About</a>
    <a href="{{ pages.contact.url | default: '/pages/contact' }}" {% if page.handle == 'contact' %}aria-current="page"{% endif %}>Contact</a>
  {%- endif -%}
  <button
    type="button"
    class="site-nav__search-toggle"
    data-search-toggle
    aria-expanded="false"
    aria-controls="SiteSearchPanel"
  >
    Search
  </button>
  <a href="{{ routes.cart_url }}" {% if request.page_type == 'cart' %}aria-current="page"{% endif %}>
    Cart
    {%- if cart.item_count > 0 -%}
      <span class="site-nav__cart-count">({{ cart.item_count }})</span>
    {%- endif -%}
  </a>
</nav>
