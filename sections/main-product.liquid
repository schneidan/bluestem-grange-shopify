{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured = current_variant.featured_image | default: product.featured_image
  assign low_stock_threshold = section.settings.low_stock_threshold | default: 5
  assign inventory_qty = current_variant.inventory_quantity
  assign track_inventory = current_variant.inventory_management
  assign product_form_id = 'ProductForm-' | append: section.id

  assign show_low_stock = false
  assign type_down = product.type | downcase
  if type_down contains 'soap'
    assign show_low_stock = true
  endif
  for tagged in product.tags
    assign tag_down = tagged | downcase
    if tag_down == 'soap' or tag_down == 'bar soap' or tag_down contains 'bar soap'
      assign show_low_stock = true
    endif
  endfor
  for coll in product.collections
    assign handle_down = coll.handle | downcase
    assign title_down = coll.title | downcase
    if handle_down contains 'soap' or title_down contains 'soap'
      assign show_low_stock = true
    endif
  endfor

  assign show_low_now = false
  if show_low_stock and current_variant.available and track_inventory != blank and inventory_qty > 0 and inventory_qty <= low_stock_threshold
    assign show_low_now = true
  endif
-%}

<article
  class="page-width product"
  data-product
  data-section-id="{{ section.id }}"
  data-low-stock="{{ low_stock_threshold }}"
  data-show-low-stock="{% if show_low_stock %}true{% else %}false{% endif %}"
>
  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>

  <div class="product__media" data-product-gallery>
    {%- if featured -%}
      <div class="product__media-main">
        <img
          class="product__image"
          src="{{ featured | image_url: width: 1400 }}"
          alt="{{ featured.alt | default: product.title | escape }}"
          width="{{ featured.width }}"
          height="{{ featured.height }}"
          data-product-gallery-main
        >
      </div>
    {%- endif -%}

    {%- if product.images.size > 1 -%}
      <ul class="product__thumbs" role="list" aria-label="Product images">
        {%- for image in product.images -%}
          <li>
            <button
              type="button"
              class="product__thumb{% if image == featured %} is-active{% endif %}"
              data-product-gallery-thumb
              data-image-id="{{ image.id }}"
              data-src="{{ image | image_url: width: 1400 }}"
              data-alt="{{ image.alt | default: product.title | escape }}"
              aria-label="View image {{ forloop.index }} of {{ product.images.size }}"
              aria-pressed="{% if image == featured %}true{% else %}false{% endif %}"
            >
              <img
                src="{{ image | image_url: width: 240 }}"
                alt=""
                width="{{ image.width }}"
                height="{{ image.height }}"
                loading="lazy"
              >
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div>
    <h1>{{ product.title | escape }}</h1>
    <p class="product__price" data-product-price>{{ current_variant.price | money }}</p>

    <p
      class="product__inventory{% if current_variant.available == false %} product__inventory--sold-out{% elsif show_low_now %} product__inventory--low{% endif %}"
      data-product-inventory
      role="status"
      {% unless current_variant.available == false or show_low_now %}hidden{% endunless %}
    >
      {%- if current_variant.available == false -%}
        Sold out
      {%- elsif show_low_now -%}
        Low inventory — only {{ inventory_qty }} left
      {%- endif -%}
    </p>

    {%- if product.description != blank -%}
      <div class="product__description">
        {{ product.description }}
      </div>
    {%- endif -%}

    {%- form 'product', product, id: product_form_id, class: 'product-form' -%}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-variant-id>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          <div class="product-option" data-product-option data-option-index="{{ forloop.index0 }}">
            <span class="product-option__label" id="OptionLabel-{{ section.id }}-{{ option.position }}">
              {{- option.name -}}:
            </span>
            <div
              class="product-option__values"
              role="radiogroup"
              aria-labelledby="OptionLabel-{{ section.id }}-{{ option.position }}"
            >
              {%- for value in option.values -%}
                {%- assign input_id = section.id | append: '-option-' | append: option.position | append: '-' | append: forloop.index -%}
                <label class="product-option__chip" for="{{ input_id }}">
                  <input
                    class="visually-hidden"
                    type="radio"
                    id="{{ input_id }}"
                    name="option-{{ option.position }}"
                    value="{{ value | escape }}"
                    data-option-input
                    {% if option.selected_value == value %}checked{% endif %}
                  >
                  <span class="product-option__chip-text">{{ value | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endunless -%}

      <div class="product-buy" data-product-buy>
        <div class="qty-field">
          <label class="qty-field__label" for="Quantity-{{ section.id }}">Quantity:</label>
          <input
            class="qty-input"
            type="number"
            id="Quantity-{{ section.id }}"
            name="quantity"
            value="1"
            min="1"
            inputmode="numeric"
            data-qty-input
          >
        </div>

        <button type="submit" name="add" data-product-add {% unless current_variant.available %}disabled{% endunless %}>
          {%- if current_variant.available -%}
            Add to cart
          {%- else -%}
            Sold out
          {%- endif -%}
        </button>

        <p class="product__inventory-note" data-product-soldout-note {% if current_variant.available %}hidden{% endif %}>
          <a href="{{ pages.contact.url | default: '/pages/contact' }}">Contact us</a>
          if you’d like to hear when it’s back.
        </p>
      </div>
    {%- endform -%}
  </div>
</article>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "range",
      "id": "low_stock_threshold",
      "min": 1,
      "max": 20,
      "step": 1,
      "label": "Low-stock threshold (bar soap)",
      "default": 5,
      "info": "Shows a red “Low inventory” note for bar soap only (product type/tag/collection containing “soap”), when tracked stock is at or below this number."
    }
  ]
}
{% endschema %}
