{%- liquid
  assign page_image = blank

  if page.metafields.custom.side_image.value != blank
    assign page_image = page.metafields.custom.side_image.value
  elsif section.settings.image != blank
    assign page_image = section.settings.image
  endif

  assign has_image = false
  if page_image != blank
    assign has_image = true
  endif

  if page_image.alt != blank
    assign image_alt = page_image.alt
  elsif section.settings.image_alt != blank
    assign image_alt = section.settings.image_alt
  else
    assign image_alt = page.title | default: 'Contact'
  endif
-%}

<div class="page-width{% if has_image %} page-split{% endif %}">
  <article class="prose">
    <h1>{{ page.title | default: 'Contact' }}</h1>

    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      <p>
        Questions about an order or a custom batch? Write us at
        <a href="mailto:bluestem.grange@gmail.com">bluestem.grange@gmail.com</a>
        or use the form.
      </p>
    {%- endif -%}

    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p>Thanks — we will get back to you soon.</p>
      {%- endif -%}
      {%- if form.errors -%}
        <p>{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="contact-form">
        <div class="field">
          <label for="ContactName">Name</label>
          <input type="text" id="ContactName" name="contact[name]" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="ContactEmail">Email</label>
          <input type="email" id="ContactEmail" name="contact[email]" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="ContactBody">Message</label>
          <textarea id="ContactBody" name="contact[body]" required></textarea>
        </div>
        <button type="submit">Send</button>
      </div>
    {%- endform -%}
  </article>

  {%- if has_image -%}
    <figure class="page-split__media">
      <img
        class="page-split__image"
        src="{{ page_image | image_url: width: 1400 }}"
        alt="{{ image_alt | escape }}"
        width="{{ page_image.width }}"
        height="{{ page_image.height }}"
        loading="lazy"
      >
    </figure>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "paragraph",
      "content": "Preferred: set Side image on the page itself (Online Store → Pages → Contact). Optional fallback below if you use the theme editor."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image (theme editor fallback)",
      "info": "Used only when the page metafield is empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Optional. Used if the image itself has no alt text."
    }
  ]
}
{% endschema %}
