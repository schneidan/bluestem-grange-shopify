{%- liquid
  assign related_limit = section.settings.products_to_show | default: 4
  assign shown = 0
-%}

{%- if recommendations.performed -%}
  {%- if recommendations.products_count > 0 -%}
    <aside class="page-width related-products" aria-labelledby="RelatedHeading-{{ section.id }}">
      <h2 class="related-products__heading" id="RelatedHeading-{{ section.id }}">
        {{ section.settings.heading | default: 'You may also like' }}
      </h2>
      <div class="product-grid related-products__grid">
        {%- for product in recommendations.products -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    </aside>
  {%- endif -%}
{%- else -%}
  <aside
    class="page-width related-products"
    data-related-products
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ related_limit }}"
    aria-labelledby="RelatedHeading-{{ section.id }}"
  >
    <h2 class="related-products__heading" id="RelatedHeading-{{ section.id }}">
      {{ section.settings.heading | default: 'You may also like' }}
    </h2>
    <div class="product-grid related-products__grid">
      {%- liquid
        assign source_collection = product.collections.first
        if source_collection == blank
          assign source_collection = collections.all
        endif
      -%}
      {%- for related in source_collection.products -%}
        {%- if related.id != product.id and shown < related_limit -%}
          {% render 'product-card', product: related %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ]
}
{% endschema %}
