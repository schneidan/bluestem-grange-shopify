{%- liquid
  assign page_image = section.settings.image
  assign has_image = false
  if page_image != blank
    assign has_image = true
  endif

  if page_image.alt != blank
    assign image_alt = page_image.alt
  elsif section.settings.image_alt != blank
    assign image_alt = section.settings.image_alt
  else
    assign image_alt = page.title | default: section.settings.heading
  endif
-%}

<div class="page-width{% if has_image %} page-split{% endif %}">
  <article class="prose">
    <h1>{{ page.title | default: section.settings.heading }}</h1>
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      {{ section.settings.content }}
    {%- endif -%}
  </article>

  {%- if has_image -%}
    <figure class="page-split__media">
      <img
        class="page-split__image"
        src="{{ page_image | image_url: width: 1400 }}"
        alt="{{ image_alt | escape }}"
        width="{{ page_image.width }}"
        height="{{ page_image.height }}"
        loading="lazy"
      >
    </figure>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "About",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Side image",
      "info": "Appears to the right of the text on desktop. Choose a file from your media library."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Optional. Used if the image itself has no alt text."
    },
    {
      "type": "header",
      "content": "Fallback copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "About"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Fallback content",
      "default": "<p>Small-batch bar soap from Franktown, Colorado.</p>"
    }
  ]
}
{% endschema %}
