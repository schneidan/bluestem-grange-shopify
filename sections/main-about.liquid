{%- liquid
  assign has_image = false
  if page.metafields.custom.side_image.value != blank
    assign has_image = true
  endif
-%}

<div class="page-width{% if has_image %} page-split{% endif %}">
  <article class="prose">
    <h1>{{ page.title | default: section.settings.heading }}</h1>
    {%- if page.content != blank -%}
      {{ page.content }}
    {%- else -%}
      {{ section.settings.content }}
    {%- endif -%}
  </article>

  {% render 'page-side-image' %}
</div>

{% schema %}
{
  "name": "About",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Side image: edit Online Store → Pages → this page → metafield “Side image” (custom.side_image). Theme pushes will not overwrite it."
    },
    {
      "type": "header",
      "content": "Fallback copy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "About"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Fallback content",
      "default": "<p>Small-batch bar soap from Franktown, Colorado.</p>"
    }
  ]
}
{% endschema %}
